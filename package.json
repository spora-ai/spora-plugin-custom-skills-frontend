{
    "name": "spora-ai/spora-plugin-custom-skills-frontend",
    "private": true,
    "version": "0.1.0",
    "description": "Vue IIFE bundle for the Spora custom-skills admin panel. Built and shipped as type spora-plugin-frontend.",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vue-tsc --noEmit && vite build",
        "preview": "vite preview",
        "lint": "eslint .",
        "typecheck": "vue-tsc --noEmit",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "smoke": "node scripts/smoke.js",
        "clean": "node scripts/clean.js"
    },
    "dependencies": {
        "@codemirror/lang-css": "^6.3.0",
        "@codemirror/lang-html": "^6.4.0",
        "@codemirror/lang-javascript": "^6.2.0",
        "@codemirror/lang-json": "^6.0.0",
        "@codemirror/lang-python": "^6.2.0",
        "@codemirror/lang-sql": "^6.10.0",
        "@codemirror/lang-yaml": "^6.1.0",
        "@codemirror/language": "^6.11.0",
        "@codemirror/state": "^6.5.0",
        "@lezer/highlight": "^1.2.0",
        "codemirror": "^6.0.2",
        "dompurify": "^3.4.15",
        "lucide-vue-next": "^0.487.0",
        "md-editor-v3": "^6.5.4",
        "pinia": "^2.3.0",
        "vue": "^3.5.0",
        "vue-router": "^4.5.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/dompurify": "^3.0.5",
        "@vitejs/plugin-vue": "^5.2.0",
        "@vitest/coverage-v8": "^4.1.10",
        "@vue/test-utils": "^2.4.6",
        "autoprefixer": "^10.5.2",
        "eslint": "^10.3.0",
        "eslint-plugin-vue": "^10.9.0",
        "happy-dom": "^20.8.9",
        "postcss": "^8.5.16",
        "tailwindcss": "^3.4.19",
        "typescript": "^5.7.0",
        "typescript-eslint": "^8.59.1",
        "vite": "^6.0.0",
        "vitest": "^4.1.2",
        "vue-eslint-parser": "^10.4.0",
        "vue-tsc": "^2.2.0"
    }
}
